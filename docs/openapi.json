{
  "openapi": "3.1.0",
  "info": {
    "title": "VRCX-Headless external API",
    "version": "1",
    "description": "Read-only, API-key-authenticated access to the headless server's local cache. Opt-in via VRCX_API_ENABLED. Scopes: `profile:read` (Current user: id, display name, profile picture); `playtime:read` (When you were in the same instance as other players, with start/end and player count (from the game log)); `users:read` (Cached name and picture for users, looked up by id)."
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Current user",
        "description": "The VRChat account the server is logged in as: name and profile picture.",
        "tags": [
          "profile"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scope": "profile:read",
        "responses": {
          "200": {
            "description": "The current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "user"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "user": {
                      "$ref": "#/components/schemas/CurrentUser"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The server is not logged in to VRChat right now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/time-together": {
      "get": {
        "operationId": "listTimeTogether",
        "summary": "When you were in the same instance as other players",
        "description": "One entry per shared-instance interval (start, end, duration, number of other players present), newest first, for calendar mapping. Entries carry only user ids; resolve names with /api/v1/users. Limited to the last 90 days and paginated.",
        "tags": [
          "playtime"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scope": "playtime:read",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "description": "Look-back window in days; stays starting earlier are excluded. Capped at 90.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 90
            }
          },
          {
            "name": "maxOthers",
            "in": "query",
            "description": "Only intervals with at most this many other players. 0 = 1-on-1 only.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Intervals, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "since",
                    "total",
                    "results"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "since": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Start of the window used"
                    },
                    "total": {
                      "type": "integer",
                      "description": "Matching intervals before pagination"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TogetherInterval"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/time-together/{userId}": {
      "get": {
        "operationId": "getTimeTogether",
        "summary": "When you were in the same instance as one user",
        "description": "Same as the list, for a single user. Empty `results` if you have not met.",
        "tags": [
          "playtime"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scope": "playtime:read",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^usr_[0-9a-f-]+$"
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Look-back window in days; stays starting earlier are excluded. Capped at 90.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 90
            }
          },
          {
            "name": "maxOthers",
            "in": "query",
            "description": "Only intervals with at most this many other players. 0 = 1-on-1 only.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Intervals, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "since",
                    "total",
                    "results"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "since": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Start of the window used"
                    },
                    "total": {
                      "type": "integer",
                      "description": "Matching intervals before pagination"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TogetherInterval"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "getUsers",
        "summary": "Cached details for several users",
        "description": "Name and picture for up to 50 user ids, from the server's cache only (VRChat is never queried). Ids not cached are listed in `missing`.",
        "tags": [
          "users"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scope": "users:read",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "description": "Comma-separated user ids",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached users keyed by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "users",
                    "missing"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "users": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/CachedUser"
                      }
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing ids or too many",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "summary": "Cached details for one user",
        "tags": [
          "users"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scope": "users:read",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^usr_[0-9a-f-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The cached user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "user"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "user": {
                      "$ref": "#/components/schemas/CachedUser"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found (or user not in the cache)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A key from POST /api/keys: `Authorization: Bearer vrcx_<id>_<secret>`"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "profilePictureUrl",
          "avatarThumbnailUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "usr_00000000-0000-0000-0000-000000000000"
          },
          "displayName": {
            "type": "string"
          },
          "profilePictureUrl": {
            "type": "string",
            "description": "Profile picture override, else current avatar image, else user icon. Empty if none."
          },
          "avatarThumbnailUrl": {
            "type": "string"
          }
        }
      },
      "TogetherInterval": {
        "type": "object",
        "required": [
          "userId",
          "start",
          "end",
          "durationMs",
          "otherPlayerCount"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "description": "The other player. Look up details with /api/v1/users."
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1
          },
          "otherPlayerCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Distinct other players (not you, not userId) present at any point during the interval. 0 = 1-on-1."
          }
        }
      },
      "CachedUser": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "profilePictureUrl",
          "avatarThumbnailUrl"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "profilePictureUrl": {
            "type": "string"
          },
          "avatarThumbnailUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
